{
  "version": "2025.10",
  "name": "ASYS",
  "description": "Generated by scripts/palettes.mts; do not edit. The ASYS design tokens: the base set, then one scheme context. Evergreen contexts use the hand-authored themes, the other palettes the generated palette files.",
  "sets": {
    "base": {
      "description": "The tokens that are the same in every scheme.",
      "sources": [
        {
          "$ref": "base.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "scheme": {
      "description": "A palette in a theme, named <palette>-<theme>. One modifier, because a palette carries a full colour map per theme: palette and theme are not independent choices.",
      "contexts": {
        "evergreen-light": [
          {
            "$ref": "themes/light.tokens.json"
          }
        ],
        "evergreen-dark": [
          {
            "$ref": "themes/dark.tokens.json"
          }
        ],
        "evergreen-drive": [
          {
            "$ref": "themes/drive.tokens.json"
          }
        ],
        "harbour-light": [
          {
            "$ref": "palettes/harbour-light.tokens.json"
          }
        ],
        "harbour-dark": [
          {
            "$ref": "palettes/harbour-dark.tokens.json"
          }
        ],
        "harbour-drive": [
          {
            "$ref": "palettes/harbour-drive.tokens.json"
          }
        ],
        "moss-light": [
          {
            "$ref": "palettes/moss-light.tokens.json"
          }
        ],
        "moss-dark": [
          {
            "$ref": "palettes/moss-dark.tokens.json"
          }
        ],
        "moss-drive": [
          {
            "$ref": "palettes/moss-drive.tokens.json"
          }
        ],
        "graphite-light": [
          {
            "$ref": "palettes/graphite-light.tokens.json"
          }
        ],
        "graphite-dark": [
          {
            "$ref": "palettes/graphite-dark.tokens.json"
          }
        ],
        "graphite-drive": [
          {
            "$ref": "palettes/graphite-drive.tokens.json"
          }
        ]
      },
      "default": "evergreen-light",
      "$extensions": {
        "io.github.ionaru.asys": {
          "themes": {
            "light": {
              "name": "Light"
            },
            "dark": {
              "name": "Dark"
            },
            "drive": {
              "name": "Voice only"
            }
          },
          "palettes": {
            "evergreen": {
              "name": "Evergreen",
              "ground": "warm"
            },
            "harbour": {
              "name": "Harbour",
              "ground": "cool"
            },
            "moss": {
              "name": "Moss",
              "ground": "warm"
            },
            "graphite": {
              "name": "Graphite",
              "ground": "neutral"
            }
          }
        }
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/scheme"
    }
  ]
}
