{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["vitest"],
  "rules": {
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectTypeOf",
          "assert",
          "assertType",
          "errorTypeOf",
          "sqlErrorIn"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@ionaru/effect-passkeys/server", "@ionaru/effect-passkeys/testing"],
                "message": "The contract reaches browsers: import only the api entry of @ionaru/effect-passkeys."
              }
            ]
          }
        ]
      }
    }
  ]
}
