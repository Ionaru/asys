{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["vitest", "import"],
  "rules": {
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["src/scenarios/**/*.spec.ts"],
      "rules": {
        "vitest/warn-todo": "off"
      }
    }
  ]
}
