{
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["vitest"],
  "rules": {
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectTypeOf",
          "assert",
          "assertType",
          "errorTypeOf",
          "sqlErrorIn"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@ionaru/effect-passkeys/testing",
                "message": "The passkey testing helpers are for tests only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.spec.ts", "src/**/*.test-d.ts", "src/test/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
